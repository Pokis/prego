---
import "@/styles/global.css";
import { siteConfig } from "@/config/site";
import { withBase } from "@/lib/paths";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = siteConfig.description,
  image,
  currentPath = Astro.url.pathname,
  noindex = false,
  schema,
} = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.name}` : siteConfig.name;
const canonical = new URL(
  withBase(currentPath),
  Astro.site ?? Astro.url.origin,
);
const ogImage = new URL(
  withBase(image ?? "/og.webp"),
  Astro.site ?? Astro.url.origin,
);
const pathWithoutBase =
  import.meta.env.BASE_URL !== "/" &&
  currentPath.startsWith(import.meta.env.BASE_URL)
    ? `/${currentPath.slice(import.meta.env.BASE_URL.length)}`
    : currentPath;
const isCurrent = (href: string) =>
  href === "/" ? pathWithoutBase === "/" : pathWithoutBase.startsWith(href);
const serviceWorkerPath = withBase("/sw.js");
const enableServiceWorker = import.meta.env.PROD;
const evaluationBuild = siteConfig.clinicalStatus === "awaiting-review";
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content={noindex || evaluationBuild
        ? "noindex,nofollow"
        : "index,follow,max-image-preview:large"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href={withBase("/manifest.webmanifest")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    {
      schema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      )
    }
    <script is:inline define:vars={{ enableServiceWorker, serviceWorkerPath }}>
      if (enableServiceWorker && "serviceWorker" in navigator) {
        window.addEventListener("load", () =>
          navigator.serviceWorker
            .register(serviceWorkerPath)
            .catch(() => undefined),
        );
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {
      evaluationBuild && (
        <div class="site-status" role="status">
          Evaluation build · health content is awaiting qualified clinical
          review
        </div>
      )
    }
    <header class="site-header">
      <div class="shell nav-wrap">
        <a
          class="wordmark"
          href={withBase("/")}
          aria-label={`${siteConfig.name} home`}
        >
          <span class="wordmark-mark" aria-hidden="true">C</span>
          <span class="wordmark-text">{siteConfig.name}</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          {
            siteConfig.navigation.map((item) => (
              <a
                class:list={{
                  "preconception-nav": item.href === "/getting-pregnant/",
                }}
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a
            class="urgent-nav"
            href={withBase("/urgent-help/")}
            aria-current={isCurrent("/urgent-help/") ? "page" : undefined}
            >Urgent help</a
          >
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav class="mobile-menu" aria-label="Mobile navigation">
            {
              siteConfig.navigation.map((item) => (
                <a
                  class:list={{
                    "preconception-nav": item.href === "/getting-pregnant/",
                  }}
                  href={withBase(item.href)}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <a class="urgent-nav" href={withBase("/urgent-help/")}
              >Urgent help</a
            >
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-grid">
          <div class="footer-brand">
            <h2>{siteConfig.name}</h2>
            <p>
              A calm, private and practical guide to the nine months of
              pregnancy, week by week. After-birth guidance continues separately
              when you need it.
            </p>
          </div>
          <div class="footer-column">
            <h3>Explore</h3>
            <a href={withBase("/getting-pregnant/")}>Getting pregnant</a>
            <a href={withBase("/timeline/")}>Timeline</a>
            <a href={withBase("/essentials/")}>Pregnancy essentials</a>
            <a href={withBase("/partners/")}>For partners</a>
            <a href={withBase("/timeline/#after-birth")}>After birth</a>
          </div>
          <div class="footer-column">
            <h3>Your data</h3>
            <a href={withBase("/privacy/")}>Privacy</a>
            <a href={withBase("/about/")}>About</a>
          </div>
          <div class="footer-column">
            <h3>Support</h3>
            <a href={withBase("/urgent-help/")}>Urgent help</a>
            <span
              >For personal decisions, talk with your doctor or midwife.</span
            >
          </div>
        </div>
        <div class="footer-bottom">
          <p>{siteConfig.educationDisclaimer}</p>
          <p>
            © {`${new Date().getFullYear()} ${siteConfig.name}`}. No
            advertising, tracking or accounts.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
