---
import "@/styles/global.css";
import { siteConfig } from "@/config/site";
import { withBase } from "@/lib/paths";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = siteConfig.description,
  image,
  currentPath = Astro.url.pathname,
  noindex = false,
  schema,
} = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.name}` : siteConfig.name;
const canonical = new URL(
  withBase(currentPath),
  Astro.site ?? Astro.url.origin,
);
const ogImage = new URL(
  withBase(image ?? "/og.webp"),
  Astro.site ?? Astro.url.origin,
);
const pathWithoutBase =
  import.meta.env.BASE_URL !== "/" &&
  currentPath.startsWith(import.meta.env.BASE_URL)
    ? `/${currentPath.slice(import.meta.env.BASE_URL.length)}`
    : currentPath;
const isCurrent = (href: string) =>
  href === "/" ? pathWithoutBase === "/" : pathWithoutBase.startsWith(href);
const serviceWorkerPath = withBase("/sw.js");
const enableServiceWorker = import.meta.env.PROD;
const evaluationBuild = siteConfig.clinicalStatus === "awaiting-review";
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content={noindex || evaluationBuild
        ? "noindex,nofollow"
        : "index,follow,max-image-preview:large"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href={withBase("/manifest.webmanifest")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    {
      schema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      )
    }
    <script is:inline define:vars={{ enableServiceWorker, serviceWorkerPath }}>
      if (enableServiceWorker && "serviceWorker" in navigator) {
        window.addEventListener("load", () =>
          navigator.serviceWorker
            .register(serviceWorkerPath)
            .catch(() => undefined),
        );
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {
      evaluationBuild && (
        <div class="site-status" role="status">
          Evaluation build · health content is awaiting qualified clinical
          review
        </div>
      )
    }
    <header class="site-header">
      <div class="shell nav-wrap">
        <a
          class="wordmark"
          href={withBase("/")}
          aria-label={`${siteConfig.name} home`}
        >
          <span class="wordmark-mark" aria-hidden="true">C</span>
          <span class="wordmark-text">{siteConfig.name}</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          {
            siteConfig.navigation.map((item) => (
              <a
                class:list={{
                  "preconception-nav": item.href === "/getting-pregnant/",
                }}
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a
            class="urgent-nav"
            href={withBase("/urgent-help/")}
            aria-current={isCurrent("/urgent-help/") ? "page" : undefined}
            >Urgent help</a
          >
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav class="mobile-menu" aria-label="Mobile navigation">
            {
              siteConfig.navigation.map((item) => (
                <a
                  class:list={{
                    "preconception-nav": item.href === "/getting-pregnant/",
                  }}
                  href={withBase(item.href)}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <a class="urgent-nav" href={withBase("/urgent-help/")}
              >Urgent help</a
            >
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <p id="share-link-status" class="visually-hidden" aria-live="polite"></p>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-grid">
          <div class="footer-brand">
            <h2>{siteConfig.name}</h2>
            <p>
              A calm, private and practical guide to the nine months of
              pregnancy, week by week. After-birth guidance continues separately
              when you need it.
            </p>
          </div>
          <div class="footer-column">
            <h3>Explore</h3>
            <a href={withBase("/getting-pregnant/")}>Getting pregnant</a>
            <a href={withBase("/timeline/")}>Timeline</a>
            <a href={withBase("/essentials/")}>Pregnancy essentials</a>
            <a href={withBase("/partners/")}>For partners</a>
            <a href={withBase("/timeline/#after-birth")}>After birth</a>
          </div>
          <div class="footer-column">
            <h3>Your data</h3>
            <a href={withBase("/privacy/")}>Privacy</a>
            <a href={withBase("/about/")}>About</a>
          </div>
          <div class="footer-column">
            <h3>Support</h3>
            <a href={withBase("/urgent-help/")}>Urgent help</a>
            <span
              >For personal decisions, talk with your doctor or midwife.</span
            >
          </div>
        </div>
        <div class="footer-bottom">
          <p>{siteConfig.educationDisclaimer}</p>
          <p>
            © {`${new Date().getFullYear()} ${siteConfig.name}`}. No
            advertising, tracking or accounts.
          </p>
        </div>
      </div>
    </footer>
    <script>
      const shareStatus = document.querySelector("#share-link-status");

      const revealAddressTarget = () => {
        let targetId = "";
        try {
          targetId = decodeURIComponent(window.location.hash.slice(1));
        } catch {
          return;
        }
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;
        const root = document.documentElement;
        const previousScrollBehavior = root.style.scrollBehavior;
        root.style.scrollBehavior = "auto";
        target.scrollIntoView({ block: "start" });
        root.style.scrollBehavior = previousScrollBehavior;
      };

      const queueAddressTargetReveal = () => {
        window.requestAnimationFrame(() =>
          window.requestAnimationFrame(revealAddressTarget),
        );
      };

      if (document.readyState === "complete") queueAddressTargetReveal();
      else
        window.addEventListener("load", queueAddressTargetReveal, {
          once: true,
        });
      window.addEventListener("pageshow", queueAddressTargetReveal, {
        once: true,
      });
      window.addEventListener("hashchange", queueAddressTargetReveal);
      if (window.location.hash) window.setTimeout(revealAddressTarget, 160);
      if (window.location.hash) window.setTimeout(revealAddressTarget, 500);
      document.fonts.ready.then(queueAddressTargetReveal);
      document.querySelectorAll("astro-island").forEach((island) =>
        island.addEventListener("astro:hydrate", queueAddressTargetReveal, {
          once: true,
        }),
      );

      const copyShareAddress = async (address: string) => {
        if (navigator.clipboard?.writeText) {
          try {
            await navigator.clipboard.writeText(address);
            return true;
          } catch {
            // Continue to the local document-copy fallback.
          }
        }

        const field = document.createElement("textarea");
        field.value = address;
        field.setAttribute("readonly", "");
        field.style.position = "fixed";
        field.style.opacity = "0";
        document.body.append(field);
        field.select();
        const copied = document.execCommand("copy");
        field.remove();
        return copied;
      };

      document.addEventListener("click", async (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          !(event.target instanceof Element)
        )
          return;

        const link = event.target.closest<HTMLAnchorElement>(
          "a[data-share-anchor]",
        );
        if (!link) return;

        const targetId = link.dataset.shareAnchor;
        const target = targetId ? document.getElementById(targetId) : null;
        if (!targetId || !target) return;

        event.preventDefault();
        const address = new URL(window.location.href);
        address.hash = targetId;
        const copied = await copyShareAddress(address.href);

        window.location.hash = targetId;
        revealAddressTarget();
        target.focus({ preventScroll: true });

        const label = link.dataset.shareLabel ?? "this finding";
        const copy = link.querySelector<HTMLElement>(".share-anchor-copy");
        const previousCopy = copy?.textContent ?? "Copy link";
        link.classList.toggle("is-copied", copied);
        if (copy) copy.textContent = copied ? "Copied" : "Link selected";
        if (shareStatus)
          shareStatus.textContent = copied
            ? `Link to ${label} copied.`
            : `Link to ${label} selected in the address bar.`;

        window.setTimeout(() => {
          link.classList.remove("is-copied");
          if (copy) copy.textContent = previousCopy;
        }, 2200);
      });
    </script>
  </body>
</html>
