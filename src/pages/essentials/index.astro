---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EssentialTopicDirectory from "@/components/EssentialTopicDirectory.astro";
import AnswerDirectory from "@/components/react/AnswerDirectory";
import RecentFindings from "@/components/react/RecentFindings";
import SiteSearch from "@/components/react/SiteSearch";
import SwapFinder from "@/components/react/SwapFinder";
import ShareAnchor from "@/components/react/ShareAnchor";
import {
  findingHref,
  findingIntentDefinitions,
  findingPriority,
  formatReviewDate,
} from "@/lib/findings";
import { withBase } from "@/lib/paths";

const topics = (await getCollection("essentials"))
  .map((item) => item.data)
  .sort((a, b) => a.number - b.number);
const substitutions = (await getCollection("substitutions")).map(
  (item) => item.data,
);
const findings = (await getCollection("findings"))
  .map((item) => item.data)
  .sort(
    (a, b) =>
      findingPriority[a.priority] - findingPriority[b.priority] ||
      a.title.localeCompare(b.title),
  );
const directoryTopics = topics.map((topic) => ({
  ...topic,
  findingCount: findings.filter((finding) => finding.sectionId === topic.id)
    .length,
  examples: findings
    .filter(
      (finding) =>
        finding.sectionId === topic.id && finding.priority !== "baseline",
    )
    .slice(0, 3)
    .map((finding) => finding.title),
}));
const recentCatalog = findings.map((finding) => ({
  id: finding.id,
  title: finding.title,
  summary: finding.summary,
  href: findingHref(finding.id),
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "Pregnancy essentials: clear dos and don'ts",
  description:
    "Direct pregnancy guidance for food, drinks, activities, medicines, symptoms, tests, work, health conditions, complications and birth preparation.",
  lastReviewed: topics[0]?.review.reviewedAt,
};
---

<BaseLayout
  title="Pregnancy essentials: find a direct answer"
  description={`Search ${findings.length} source-backed pregnancy findings or browse complete do, don’t and check-first guidance by topic.`}
  schema={schema}
>
  <section class="page-hero essentials-hero essentials-overview-hero">
    <div class="shell">
      <p class="eyebrow">One handbook · no hidden answers</p>
      <h1>Find the pregnancy<br />answer you need.</h1>
      <p class="lede">
        Search the whole guide or explore {findings.length} direct answers across
        {topics.length} clearly named topics. Every answer has a permanent link, care
        threshold and review date.
      </p>
    </div>
  </section>

  <nav class="essentials-page-nav" aria-label="On this Essentials page">
    <div class="shell">
      <span>You are in Pregnancy essentials</span>
      <a href="#find-an-answer">Search</a>
      <a href="#start-with-your-question">Browse by need</a>
      <a href="#pregnancy-topic-directory">See all {topics.length} topics</a>
      <a href="#answer-library">Filter {findings.length} answers</a>
      <a href="#smart-swaps">Food and drink swaps</a>
    </div>
  </nav>

  <section
    class="section essentials-search-section"
    id="find-an-answer"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor targetId="find-an-answer" label="pregnancy answer search" />
      <SiteSearch client:load />
      <div
        class="doctor-banner essentials-search-boundary"
        id="individual-care-baseline"
        data-share-target
        tabindex="-1"
      >
        <ShareAnchor
          targetId="individual-care-baseline"
          label="individual care baseline"
          compact
        />
        <strong>Use this as the general baseline.</strong>
        Your doctor or midwife should make decisions that depend on your health, medicines,
        symptoms or pregnancy. Search cannot assess a symptom.
      </div>
    </div>
  </section>

  <section
    class="section soft intent-section"
    id="start-with-your-question"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor
        targetId="start-with-your-question"
        label="pregnancy question starting points"
      />
      <div class="section-heading">
        <div>
          <p class="eyebrow">Start with what you are trying to do</p>
          <h2>Choose the kind of answer you need</h2>
          <p>
            These shortcuts filter the complete answer library below. They do
            not assess a symptom or make a personal recommendation.
          </p>
        </div>
      </div>
      <nav class="intent-grid" aria-label="Browse by question type">
        {
          findingIntentDefinitions.map((intent) => (
            <a href={withBase(intent.href)}>
              <strong>{intent.label}</strong>
              <span>{intent.detail}</span>
              <small>Filter all matching answers →</small>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="section personal-finding-section">
    <div class="shell">
      <RecentFindings client:load catalog={recentCatalog} />
    </div>
  </section>

  <section class="section topic-directory-section">
    <div class="shell">
      <EssentialTopicDirectory
        topics={directoryTopics}
        heading="See the whole handbook before you choose"
        description={`There are ${topics.length} complete topics and ${findings.length} direct answers. Every topic page keeps its practical baseline and its own smaller answer collection together.`}
      />
    </div>
  </section>

  <section
    class="section soft answer-library-section"
    id="answer-library"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor
        targetId="answer-library"
        label="pregnancy direct-answer library"
      />
      <div class="section-heading">
        <div>
          <p class="eyebrow">One filterable collection</p>
          <h2>Find your way through every direct answer</h2>
          <p>
            Filter by topic, the job you are trying to do and the next step the
            answer may require. The focused view removes short baseline records
            that can look repetitive beside deeper answers; searching still
            checks the complete collection.
          </p>
        </div>
      </div>
      <AnswerDirectory
        client:load
        findings={findings}
        topics={topics.map((topic) => ({ id: topic.id, title: topic.title }))}
      />
    </div>
  </section>

  <section
    class="section swap-section"
    id="smart-swaps"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor targetId="smart-swaps" label="pregnancy swap finder" />
      <header class="swap-section-heading">
        <div>
          <p class="eyebrow">A separate, food-and-drink-only tool</p>
          <h2>Looking for a practical substitute?</h2>
        </div>
        <p>
          The main search above covers the whole guide. Use this smaller finder
          only when you want an alternative to coffee, cola, sushi, cheese or
          another familiar food or drink.
        </p>
      </header>
      <SwapFinder client:load items={substitutions} />
    </div>
  </section>

  <div class="shell essentials-review-note">
    <p class="reviewed-date">
      Topic records updated {
        formatReviewDate(topics[0]?.review.reviewedAt ?? "2026-08-03")
      }. Every permanent answer remains available through its topic and the
      filterable library.
    </p>
  </div>
</BaseLayout>
