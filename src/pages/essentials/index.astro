---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EssentialTopicDirectory from "@/components/EssentialTopicDirectory.astro";
import FindingSummary from "@/components/FindingSummary.astro";
import RecentFindings from "@/components/react/RecentFindings";
import SiteSearch from "@/components/react/SiteSearch";
import SwapFinder from "@/components/react/SwapFinder";
import ShareAnchor from "@/components/react/ShareAnchor";
import {
  essentialTopicHref,
  findingHref,
  findingIntentDefinitions,
  findingPriority,
  findingStatusLabels,
  formatReviewDate,
} from "@/lib/findings";
import { withBase } from "@/lib/paths";

const topics = (await getCollection("essentials"))
  .map((item) => item.data)
  .sort((a, b) => a.number - b.number);
const substitutions = (await getCollection("substitutions")).map(
  (item) => item.data,
);
const findings = (await getCollection("findings"))
  .map((item) => item.data)
  .sort(
    (a, b) =>
      findingPriority[a.priority] - findingPriority[b.priority] ||
      a.title.localeCompare(b.title),
  );
const featuredFindings = topics
  .map((topic) =>
    findings.find(
      (finding) => finding.sectionId === topic.id && finding.priority === "P0",
    ),
  )
  .filter((finding): finding is NonNullable<typeof finding> =>
    Boolean(finding),
  );
const recentCatalog = findings.map((finding) => ({
  id: finding.id,
  title: finding.title,
  summary: finding.summary,
  href: findingHref(finding.id),
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "Pregnancy essentials: clear dos and don'ts",
  description:
    "Direct pregnancy guidance for food, drinks, activities, medicines, symptoms, tests, work, health conditions, complications and birth preparation.",
  lastReviewed: topics[0]?.review.reviewedAt,
};
---

<BaseLayout
  title="Pregnancy essentials: find a direct answer"
  description="Search 419 source-backed pregnancy findings or browse complete do, don’t and check-first guidance by topic."
  schema={schema}
>
  <section class="page-hero essentials-hero essentials-overview-hero">
    <div class="shell">
      <p class="eyebrow">One handbook · no hidden answers</p>
      <h1>Find the pregnancy<br />answer you need.</h1>
      <p class="lede">
        Search the whole guide, start with what you are trying to do, or browse
        one complete topic. Every direct answer has a stable page, care
        threshold and review date.
      </p>
    </div>
  </section>

  <section
    class="section essentials-search-section"
    id="find-an-answer"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor targetId="find-an-answer" label="pregnancy answer search" />
      <SiteSearch client:load />
      <div
        class="doctor-banner essentials-search-boundary"
        id="individual-care-baseline"
        data-share-target
        tabindex="-1"
      >
        <ShareAnchor
          targetId="individual-care-baseline"
          label="individual care baseline"
          compact
        />
        <strong>Use this as the general baseline.</strong>
        Your doctor or midwife should make decisions that depend on your health, medicines,
        symptoms or pregnancy. Search cannot assess a symptom.
      </div>
    </div>
  </section>

  <section
    class="section soft intent-section"
    id="start-with-your-question"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor
        targetId="start-with-your-question"
        label="pregnancy question starting points"
      />
      <div class="section-heading">
        <div>
          <p class="eyebrow">Start with what you are trying to do</p>
          <h2>Six clearer ways into the handbook</h2>
          <p>
            These are navigation shortcuts, not a symptom checker. Each opens a
            complete pregnancy topic with visible guidance.
          </p>
        </div>
      </div>
      <nav class="intent-grid" aria-label="Browse by question type">
        {
          findingIntentDefinitions.map((intent) => (
            <a href={withBase(intent.href)}>
              <strong>{intent.label}</strong>
              <span>{intent.detail}</span>
              <small>Browse guidance →</small>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="section personal-finding-section">
    <div class="shell">
      <RecentFindings client:load catalog={recentCatalog} />
    </div>
  </section>

  <section class="section topic-directory-section">
    <div class="shell">
      <EssentialTopicDirectory topics={topics} />
    </div>
  </section>

  <section
    class="section soft essentials-baseline-overview"
    id="everyday-baseline"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor
        targetId="everyday-baseline"
        label="pregnancy essentials baseline"
      />
      <div class="section-heading">
        <div>
          <p class="eyebrow">Useful without search</p>
          <h2>Every topic at a glance</h2>
          <p>
            The first do, don’t and check-first action remains visible here.
            Open a topic for its full baseline and every direct answer.
          </p>
        </div>
      </div>
      <div class="baseline-topic-grid">
        {
          topics.map((topic) => (
            <article>
              <span class="baseline-topic-number" aria-hidden="true">
                {String(topic.number).padStart(2, "0")}
              </span>
              <p class="eyebrow">{topic.eyebrow}</p>
              <h3>{topic.title}</h3>
              <p>{topic.intro}</p>
              <dl>
                <div>
                  <dt>Do</dt>
                  <dd>{topic.dos[0]}</dd>
                </div>
                <div>
                  <dt>Don’t</dt>
                  <dd>{topic.donts[0]}</dd>
                </div>
                <div>
                  <dt>Check first</dt>
                  <dd>{topic.askDoctor[0]}</dd>
                </div>
              </dl>
              <a href={withBase(essentialTopicHref(topic.slug))}>
                Open {topic.title.toLowerCase()} →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section featured-finding-section"
    id="important-direct-answers"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor
        targetId="important-direct-answers"
        label="important pregnancy direct answers"
      />
      <div class="section-heading">
        <div>
          <p class="eyebrow">Important direct answers</p>
          <h2>One high-priority answer from every topic</h2>
          <p>
            These are broad entry points. Open any answer for its full factors,
            care threshold, related guidance, save, share and print controls.
          </p>
        </div>
      </div>
      <div class="featured-finding-grid">
        {
          featuredFindings.map((finding) => (
            <FindingSummary finding={finding} compact idPrefix="featured-" />
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section swap-section"
    id="smart-swaps"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor targetId="smart-swaps" label="pregnancy swap finder" />
      <header class="swap-section-heading">
        <div>
          <p class="eyebrow">A separate, food-and-drink-only tool</p>
          <h2>Looking for a practical substitute?</h2>
        </div>
        <p>
          The main search above covers the whole guide. Use this smaller finder
          only when you want an alternative to coffee, cola, sushi, cheese or
          another familiar food or drink.
        </p>
      </header>
      <SwapFinder client:visible items={substitutions} />
    </div>
  </section>

  <section
    class="section soft legacy-finding-directory"
    id="all-direct-answers"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor
        targetId="all-direct-answers"
        label="all pregnancy direct answers"
      />
      <div class="section-heading">
        <div>
          <p class="eyebrow">Stable link directory</p>
          <h2>All {findings.length} answers, A–Z</h2>
          <p>
            Existing shared anchors remain valid. Each item now opens a smaller,
            permanent finding page with its complete guidance.
          </p>
        </div>
      </div>
      <ol class="legacy-finding-list">
        {
          [...findings]
            .sort((a, b) => a.title.localeCompare(b.title))
            .map((finding) => (
              <li id={finding.id} data-share-target tabindex="-1">
                <a href={withBase(findingHref(finding.id))}>
                  <span class={`example-status ${finding.status}`}>
                    {findingStatusLabels[finding.status]}
                  </span>
                  <strong>{finding.title}</strong>
                  <small>{finding.summary}</small>
                </a>
              </li>
            ))
        }
      </ol>
      <p class="reviewed-date">
        Topic records reviewed {
          formatReviewDate(topics[0]?.review.reviewedAt ?? "2026-08-03")
        }. Qualified clinical sign-off remains pending for this evaluation
        build.
      </p>
    </div>
  </section>
</BaseLayout>
