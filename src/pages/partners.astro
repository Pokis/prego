---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ShareAnchor from "@/components/react/ShareAnchor";
import { anchorSlug } from "@/lib/anchors";
import { withBase } from "@/lib/paths";
import { milestoneWindowLabel, sortMilestones } from "@/lib/milestones";
const milestones = await getCollection("milestones");
const timeline = await getCollection("timeline");
const partnerWeeks = new Set([
  "week-4",
  "week-8",
  "week-12",
  "week-18",
  "week-20",
  "week-28",
  "week-32",
  "week-36",
  "week-38",
  "week-40",
]);
const partnerCheckpoints = timeline
  .filter((entry) => partnerWeeks.has(entry.data.id))
  .sort((a, b) => a.data.ordinal - b.data.ordinal);
const pregnancyMilestones = sortMilestones(
  milestones
    .filter((item) => item.data.anchor !== "birth-day")
    .map((item) => item.data),
).slice(0, 9);
---

<BaseLayout
  title="For partners and support people"
  description="Concrete support actions from the positive test through six months after birth."
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">For partners and support people</p><h1>
        Care is more than<br />being nearby.
      </h1><p class="lede">
        Listen, learn the warning signs, own practical work, and protect the
        recovering family's space.
      </p><div class="button-row">
        <a class="button" href={withBase("/timeline/")}
          >Follow the pregnancy timeline</a
        ><a class="button secondary" href={withBase("/urgent-help/")}
          >Learn urgent signs</a
        >
      </div>
    </div>
  </section>
  <section
    class="section soft"
    id="support-basics"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor targetId="support-basics" label="support basics" />
      <div class="card-grid four">
        <article
          class="editorial-card"
          id="support-before-appointments"
          data-share-target
          tabindex="-1"
        >
          <ShareAnchor
            targetId="support-before-appointments"
            label="support before appointments"
            compact
          />
          <span class="index">Before appointments</span><h3>
            Make room, not decisions
          </h3><p>
            Help collect questions, manage logistics and ensure private
            conversation remains possible.
          </p>
        </article>
        <article
          class="editorial-card"
          id="support-during-pregnancy"
          data-share-target
          tabindex="-1"
        >
          <ShareAnchor
            targetId="support-during-pregnancy"
            label="support during pregnancy"
            compact
          />
          <span class="index">During pregnancy</span><h3>Own visible work</h3><p
          >
            Meals, cleaning, transport and administration should not wait to be
            assigned.
          </p>
        </article>
        <article
          class="editorial-card"
          id="support-at-birth"
          data-share-target
          tabindex="-1"
        >
          <ShareAnchor
            targetId="support-at-birth"
            label="support at birth"
            compact
          />
          <span class="index">At birth</span><h3>Protect communication</h3><p>
            Reinforce expressed preferences, stay flexible and alert staff to
            concerns.
          </p>
        </article>
        <article
          class="editorial-card"
          id="support-after-birth"
          data-share-target
          tabindex="-1"
        >
          <ShareAnchor
            targetId="support-after-birth"
            label="support after birth"
            compact
          />
          <span class="index">After birth</span><h3>Notice both people</h3><p>
            Parent recovery and baby health both need attention, rest and
            follow-up.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="section" id="weekly-support" data-share-target tabindex="-1">
    <div class="shell">
      <ShareAnchor targetId="weekly-support" label="weekly support actions" />
      <div class="section-heading">
        <div>
          <p class="eyebrow">Pregnancy checkpoints</p><h2>
            What useful support looks like, week by week
          </h2>
          <p>These actions are all visible—no FAQ or hidden checklist.</p>
        </div>
      </div><div class="guide-grid">
        {
          partnerCheckpoints.map((entry) => (
            <article
              class="guide-card"
              id={`support-${entry.data.id}`}
              data-share-target
              tabindex="-1"
            >
              <ShareAnchor
                targetId={`support-${entry.data.id}`}
                label={entry.data.title}
                compact
              />
              <p class="eyebrow">{entry.data.windowLabel}</p>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.partner[0]}</p>
              <a href={withBase(`/timeline/${entry.data.slug}/`)}>
                Open this week →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section
    class="section plum"
    id="shared-checkpoints"
    data-share-target
    tabindex="-1"
  >
    <div class="shell">
      <ShareAnchor targetId="shared-checkpoints" label="shared checkpoints" />
      <div class="section-heading">
        <div>
          <p class="eyebrow">Shared checkpoints</p><h2>
            Know what may be coming
          </h2>
        </div>
      </div><div class="milestone-board">
        {
          pregnancyMilestones.map((item) => (
            <article
              class="milestone-card"
              id={`partner-milestone-${anchorSlug(item.id)}`}
              data-share-target
              tabindex="-1"
            >
              <ShareAnchor
                targetId={`partner-milestone-${anchorSlug(item.id)}`}
                label={item.title}
                compact
              />
              <>
                <div class="meta">{milestoneWindowLabel(item)}</div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
